<%
  ann = locals[:ann]
  next_ann = locals[:next_ann]
  is_active = locals[:is_active]
  parent_uuid = ann.previous&.execution_id
  card_path = locals[:card_path]
  delete_path = locals[:delete_path]
  is_leaf = locals[:is_leaf]

  # Hide attached-file data URIs so the base64 blob doesn't dominate the
  # 30-char preview. Images use `![alt](data:…)` and get replaced with `[image]`;
  # documents use `[filename](data:…)` and get replaced with `[filename]`
  # (or `[document]` if the filename slot is empty).
  display_prompt = ann.prompt.to_s
                     .gsub(/!\[[^\]]*\]\(data:[^)]+\)/m, "[image]")
                     .gsub(/(?<!!)\[([^\]]*)\]\(data:[^)]+\)/m) { "[#{Regexp.last_match(1).presence || 'document'}]" }
                     .strip
%>

<%
  # Nodes this prompt cites. Their content reaches the model as material for
  # this turn, not as dialogue — which is what the dotted arrow means, as
  # against the solid one for the lineage.
  #
  # This reads an association per card. Hosts rendering a long pane should
  # preload it (`includes(:supplements)`); chains are short enough that the
  # gem does not force the issue, same reasoning as `ancestors`.
  supplement_uuids = ann.respond_to?(:supplements) ? ann.supplements.map(&:execution_id) : []
%>
<div class="history-card<%= ' is-active' if is_active %>" data-history-target="cards" data-uuid="<%= ann.execution_id %>" data-parent-uuid="<%= parent_uuid %>" data-supplement-uuids="<%= supplement_uuids.join(",") %>">
  <div class="history-card-row">
    <%= link_to card_path.call(ann.execution_id), class: "history-card-link" do %>
      <div class="history-card-prompt"><%= truncate(display_prompt, length: 30) %></div>
    <% end %>
    <% if is_leaf && delete_path %>
      <%= button_to delete_path.call(ann.execution_id),
                    method: :delete,
                    class: "history-card-delete",
                    title: "Delete this prompt",
                    form: { class: "history-card-delete-form" },
                    data: { turbo_confirm: "Delete this prompt? This cannot be undone." } do %>
        <i class="bi bi-trash"></i>
      <% end %>
    <% end %>
    <% if ann.llm_platform.present? %>
      <% platform_label = PromptNavigator.label_for(platform: ann.llm_platform, model: ann.model) %>
      <% tooltip = ann.model.present? ? "#{ann.model} (#{ann.llm_platform})" : ann.llm_platform.to_s %>
      <span class="history-card-platform-label" data-platform="<%= ann.llm_platform %>" title="<%= tooltip %>"><%= platform_label %></span>
    <% end %>
  </div>
</div>

<%# Direction-agnostic adjacency arrow: detect whether the next card is this card's
    parent (newest-first ordering → "↑") or its child (oldest-first ordering → "↓"). %>
<% if next_ann %>
  <% if parent_uuid == next_ann.execution_id %>
    <div class="history-straight-arrow">↑</div>
  <% elsif next_ann.previous_id == ann.id %>
    <div class="history-straight-arrow">↓</div>
  <% end %>
<% end %>
